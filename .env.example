# =============================================================================
# Khatabook AI – Deployment Environment Variables
# =============================================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to version control.
# =============================================================================

# ── Core ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3004

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/khatabook_ai"
DIRECT_URL="postgresql://user:password@localhost:5432/khatabook_ai"

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-key-change-in-production-make-it-long"
WEBHOOK_SECRET="your-webhook-signing-secret"

# ── OpenAI (AI Features) ───────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# ── Razorpay (Payments) ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# ── Twilio (WhatsApp / SMS / Email) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
TWILIO_MESSAGING_SERVICE_SID="MG..."

# ── Supabase (File Storage) ────────────────────────────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Frontend URLs ──────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# ── App Config ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=12

# ── Storage ────────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=supabase # supabase | local | s3
LOCAL_UPLOAD_DIR=./uploads

# ── Email (optional, for invoices / reminders) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Khatabook AI <noreply@khatabook.ai>"

# ── Observability (optional) ───────────────────────────────────────────────────
SENTRY_DSN=""
LOGTAIL_SOURCE_TOKEN=""
