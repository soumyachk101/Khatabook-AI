logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables
.env
.env.local
.env.local.example
.env.development.local
.env.test.local
.env.production.local
.env.staging.local

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS / System
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Docker
docker-compose.override.yml
.dockerignore

# Redis
dump.rdb

# Coverage
coverage/

# Cache
.cache/

# Supabase
.supabase/

