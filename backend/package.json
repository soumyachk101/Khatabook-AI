{
 "name": "khatabook-ai-backend",
 "version": "1.0.0",
 "description": "Backend for Khatabook-AI - Smart Bookkeeping with AI",
 "main": "dist/index.js",
 "scripts": {
 "dev": "tsx watch src/index.ts",
 "build": "tsc",
 "start": "node dist/index.js",
 "db:generate": "prisma migrate dev --name init",
 "db:migrate": "prisma migrate deploy",
 "db:seed": "tsx prisma/seed.ts",
 "db:studio": "prisma studio",
 "worker": "tsx src/queue/worker.ts"
 },
 "dependencies": {
 "fastify": "^4.28.0",
 "@fastify/cors": "^9.0.0",
 "@fastify/jwt": "^8.0.0",
 "@fastify/rate-limit": "^9.0.0",
 "@prisma/client": "^5.22.0",
 "bullmq": "^5.1.0",
 "ioredis": "^5.4.0",
 "openai": "^4.68.0",
 "tesseract.js": "^5.1.0",
 "razorpay": "^2.9.0",
 "twilio": "^5.3.0",
 "@supabase/supabase-js": "^2.45.0",
 "zod": "^3.23.0",
 "pdf-lib": "^1.17.0",
 "qrcode": "^1.5.0",
 "pino": "^9.5.0",
 "bcrypt": "^5.1.0"
 },
 "devDependencies": {
 "typescript": "^5.6.0",
 "tsx": "^4.19.0",
 "@types/node": "^22.0.0",
 "@types/bcrypt": "^5.0.0",
 "@types/qrcode": "^1.5.0",
 "@types/pdf-lib": "^1.17.0"
 }
}
