{
 "compilerOptions": {
 "target": "ES2022",
 "module": "CommonJS",
 "moduleResolution": "Node",
 "outDir": "./dist",
 "rootDir": "./src",
 "strict": true,
 "esModuleInterop": true,
 "skipLibCheck": true,
 "forceConsistentCasingInFileNames": true,
 "resolveJsonModule": true,
 "sourceMap": true,
 "declaration": true,
 "declarationMap": true
 },
 "include": ["src/**/*", "prisma/seed.ts"],
 "exclude": ["node_modules", "dist"]
}
