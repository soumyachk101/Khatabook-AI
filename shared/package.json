{
 "name": "@khatabook/shared",
 "version": "1.0.0",
 "private": true,
 "description": "Khatabook AI — Shared types, constants, and utilities consumed by frontend and backend",
 "main": "./dist/index.js",
 "module": "./dist/index.js",
 "types": "./dist/index.d.ts",
 "exports": {
 ".": {
 "types": "./dist/index.d.ts",
 "default": "./dist/index.js"
 },
 "./types/*": {
 "types": "./dist/types/*.d.ts",
 "default": "./dist/types/*.js"
 },
 "./constants/*": {
 "types": "./dist/constants/*.d.ts",
 "default": "./dist/constants/*.js"
 },
 "./utils/*": {
 "types": "./dist/utils/*.d.ts",
 "default": "./dist/utils/*.js"
 }
 },
 "scripts": {
 "dev": "tsc --watch",
 "build": "tsc",
 "clean": "rimraf dist",
 "typecheck": "tsc --noEmit"
 },
 "devDependencies": {
 "@types/node": "^20.11.0",
 "@types/uuid": "^10.0.0",
 "rimraf": "^5.0.5",
 "typescript": "^5.4.0"
 },
 "dependencies": {
 "zod": "^3.23.0"
 }
}
